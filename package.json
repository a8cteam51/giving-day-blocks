{
  "name": "giving-day-blocks",
  "version": "1.0.1",
  "description": "An out-of-the-box Giving Day product for WooCommerce. Blocks, data layer, and admin dashboard for running a fundraiser event.",
  "author": {
    "name": "Team51 Special Projects",
    "url": "https://wpspecialprojects.wordpress.com"
  },
  "license": "GPL-2.0-or-later",
  "keywords": [
    "wordpress",
    "woocommerce",
    "donation",
    "fundraising",
    "giving-day",
    "blocks"
  ],
  "homepage": "https://github.com/a8cteam51/giving-day-blocks",
  "repository": "https://github.com/a8cteam51/giving-day-blocks",
  "bugs": "https://github.com/a8cteam51/giving-day-blocks/issues",
  "private": true,
  "engines": {
    "node": ">=20.10",
    "npm": ">=10.2"
  },
  "devDependencies": {
    "@wordpress/browserslist-config": "^5.25.13",
    "@wordpress/jest-preset-default": "^11.19.0",
    "@wordpress/scripts": "^26.13.13",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "npm-run-all": "^4.1.5"
  },
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ],
  "scripts": {
    "build": "npm-run-all --sequential build:blocks build:admin build:match build:team build:beneficiary",
    "build:blocks": "wp-scripts build --webpack-src-dir=blocks/src --output-path=blocks/build --webpack-copy-php",
    "build:admin": "wp-scripts build --webpack-src-dir=assets/admin-campaign --output-path=assets/build/admin-campaign",
    "build:match": "wp-scripts build --webpack-src-dir=assets/admin-match --output-path=assets/build/admin-match",
    "build:team": "wp-scripts build --webpack-src-dir=assets/admin-team --output-path=assets/build/admin-team",
    "build:beneficiary": "wp-scripts build --webpack-src-dir=assets/admin-beneficiary --output-path=assets/build/admin-beneficiary",
    "start": "wp-scripts start --webpack-src-dir=blocks/src --output-path=blocks/build --webpack-copy-php",
    "start:admin": "wp-scripts start --webpack-src-dir=assets/admin-campaign --output-path=assets/build/admin-campaign",
    "start:match": "wp-scripts start --webpack-src-dir=assets/admin-match --output-path=assets/build/admin-match",
    "start:team": "wp-scripts start --webpack-src-dir=assets/admin-team --output-path=assets/build/admin-team",
    "start:beneficiary": "wp-scripts start --webpack-src-dir=assets/admin-beneficiary --output-path=assets/build/admin-beneficiary",
    "format": "npm-run-all --sequential format:**",
    "format:scripts": "wp-scripts format blocks assets --no-error-on-unmatched-pattern",
    "format:styles": "npm run lint:styles -- --fix",
    "lint": "npm-run-all --sequential lint:**",
    "lint:scripts": "wp-scripts lint-js blocks assets --no-error-on-unmatched-pattern",
    "lint:styles": "wp-scripts lint-style \"blocks/**/*.{css,sass,scss}\" --allow-empty-input --report-descriptionless-disables --report-invalid-scope-disables --report-needless-disables",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "lint:readme-md": "wp-scripts lint-md-docs README.md",
    "test": "wp-scripts test-unit-js --config jest.config.js",
    "test:watch": "wp-scripts test-unit-js --config jest.config.js --watch",
    "check-engines": "wp-scripts check-engines",
    "check-licenses": "wp-scripts check-licenses"
  }
}
