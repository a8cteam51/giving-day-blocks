{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "giving-day/causes-browser",
  "version": "0.3.0",
  "title": "Giving Day: Cause Areas Browser",
  "category": "widgets",
  "icon": "grid-view",
  "description": "Browse Cause Areas in a responsive grid; drill into sub-areas or beneficiaries; mobile-first beneficiary search. No page reloads.",
  "keywords": [
    "giving day",
    "causes",
    "cause areas",
    "beneficiaries",
    "browse",
    "grid",
    "search"
  ],
  "textdomain": "giving-day-blocks",
  "supports": {
    "html": false,
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    },
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Browse Cause Areas"
    },
    "columnsDesktop": {
      "type": "number",
      "default": 4
    },
    "showCounts": {
      "type": "boolean",
      "default": true
    },
    "searchPlaceholder": {
      "type": "string",
      "default": "Search beneficiaries"
    }
  },
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "style": "file:./style-index.css",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php"
}