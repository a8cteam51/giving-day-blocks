{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "giving-day/countdown",
	"version": "0.1.0",
	"title": "Giving Day: Countdown",
	"category": "widgets",
	"icon": "clock",
	"description": "Pre-event countdown, event-day countdown, and post-event totals in a single slot. Transitions automatically.",
	"keywords": [ "giving day", "countdown", "totals", "campaign" ],
	"textdomain": "giving-day-blocks",
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"align": [ "wide", "full" ]
	},
	"attributes": {
		"campaignId": {
			"type": "number"
		},
		"hidePostEvent": {
			"type": "boolean",
			"default": false
		},
		"preHeadline": {
			"type": "string",
			"default": "Giving Day starts in"
		},
		"liveHeadline": {
			"type": "string",
			"default": "Giving now"
		},
		"endedHeadline": {
			"type": "string",
			"default": "Thank you!"
		},
		"showDonorCount": {
			"type": "boolean",
			"default": true
		},
		"previewState": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css",
	"render": "file:./render.php"
}
